PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Prefer a full connection string once you share your credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vidyesh_db

# Optional individual values if you don't want to use DATABASE_URL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vidyesh_db
DB_USER=postgres
DB_PASSWORD=postgres

# Optional. Needed when some image fields store only an Nhost file UUID.
NHOST_STORAGE_BASE_URL=https://oxsetgbfcrtlfjmvwkmk.storage.ap-south-1.nhost.run/v1/files

# Optional. When set, image requests will be served from S3 while keeping local uploads as lookup/fallback.
# Example if the bucket is public at the root:
# S3_PUBLIC_BASE_URL=https://vgc-murtis-images.s3.ap-south-1.amazonaws.com
S3_PUBLIC_BASE_URL=

# Optional folder prefix inside the bucket, for example "murtis" or "uploads".
S3_UPLOADS_PREFIX=

# Set to true only if your bucket keeps the local relative path, e.g. "murtis/file.jpg".
# Leave false if files are uploaded flat at the bucket root.
S3_PRESERVE_UPLOAD_PATH=false
